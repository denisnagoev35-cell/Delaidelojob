# Скопировать в /etc/ddbot.env и вписать токен. Файл не выкладывать никуда.
BOT_TOKEN=ВСТАВЬ_ТОКЕН_ОТ_BOTFATHER
CHANNEL=@delaidelojob
# Пригласительная ссылка «Бот» из настроек канала — чтобы считать подписчиков из бота
CHANNEL_INVITE=https://t.me/delaidelojob
# Твой числовой Telegram ID (узнать у @userinfobot) — для команды /stats
ADMIN_IDS=
DB_PATH=/opt/ddbot/data/ddbot.sqlite3
# YandexGPT для разбора вакансий (Yandex Cloud: API-ключ сервисного аккаунта с ролью ai.languageModels.user)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
