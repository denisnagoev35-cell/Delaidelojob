# Скопировать в /etc/ddbot.env и вписать токен. Файл не выкладывать никуда.
BOT_TOKEN=ВСТАВЬ_ТОКЕН_ОТ_BOTFATHER
CHANNEL=@delaidelojob
# Пригласительная ссылка «Бот» из настроек канала — чтобы считать подписчиков из бота
CHANNEL_INVITE=https://t.me/delaidelojob
# Твой числовой Telegram ID (узнать у @userinfobot) — для команды /stats
ADMIN_IDS=
DB_PATH=/opt/ddbot/data/ddbot.sqlite3
# YandexGPT для разбора вакансий (Yandex Cloud: API-ключ сервисного аккаунта с ролью ai.languageModels.user)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Кому показывать подборку и рассылку в тесте (через запятую). Команд админа у них нет.
TESTER_IDS=
# Открыть подборку всем: 1
PODBOR_FOR_ALL=
# Анкеты соискателей: test — только ADMIN_IDS/TESTER_IDS, публикация админу в личку; on — для всех, публикация в чат
ANKETA_MODE=
ANKETA_CHAT=@delaijobchat
# Анкеты для работодателей (подборка и рассылка новых анкет): test — только ADMIN_IDS/TESTER_IDS; on — все
EMP_MODE=
# Дайджест «ТОП-10 вакансий недели» по понедельникам в 15:00: test — только ADMIN_IDS (по умолчанию); on — в канал; off — выкл.
DIGEST_MODE=test
# Кто может готовить и выкладывать посты через бота (/post, /pachka, /ochered), кроме ADMIN_IDS. По умолчанию — помощник.
POST_EDITORS=703473452
